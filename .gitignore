# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Large raw source data — regenerated by each project's data-prep script.
# See README.md "Setup" for the one-time download/build commands.
data/raw_events/
data/sign_language_digits/
data/sign_mnist/
data/hpo/*.obo
data/hpo/*.hpoa
data/hpo/genes_to_phenotype.txt

# Large generated model artifacts — regenerated by preprocess.py/train_model.py
attendance_system/lbph_model.yml
attendance_system/labels.pkl

# Runtime databases (rebuilt automatically on first run)
*.db
*.db.tmp
attendance_system/attendance.csv

# Secrets (API keys) never go in the repo
.streamlit/secrets.toml
.env

# OS / editor cruft
.DS_Store
*.swp
